# Append-only research logs: when two branches both add lines at the end of the same log, a local git merge keeps both
# sides (merge with git on the command line; GitHub's merge button ignores this and reports a conflict).
docs/views/evidence/*.jsonl merge=union
docs/views/sources/*.jsonl merge=union
docs/views/searched/*.jsonl merge=union
docs/views/wanted/*.jsonl merge=union
docs/views/audit/ALL.jsonl merge=union
docs/tracks/progress/*.md merge=union
