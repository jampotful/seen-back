        "shares": {
          "m": 0.0,
          "g": 0.213,
          "i": 0.787
        },
        "species": 39,
        "text": "Nobody has measured how sharply most of you see, only how closely your light-sensing cells sit. If you are a bold jumping spider, the cells in the sharpest zone of your side eyes sit about half a degree apart. In the big front eyes of Phidippus johnsoni, a relative, they sit about 9 minutes of arc apart, which is much less than a degree.",
        "cites": [
          {
            "id": "jumper#114",
            "taxon": "Phidippus audax",
            "trait": "interreceptor_deg",
            "grade": "m",
            "source": "Goté 2019"
          },
