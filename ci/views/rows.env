# Settings for .github/workflows/views-rows.yml (read by ci/views/rows.sh). Push a commit to run/views-rows/<label> to run.
#
# The views to draft, comma separated. The first eight are the views with the most evidence records.
ROWS_VIEWS=bird,insect,spider,jumper,dog,cat,bee,plant
# The model (a model needs a price in tools/lit/extract.py).
ROWS_MODEL=claude-sonnet-5-5
# The most the run may spend, in US dollars at batch prices, judged by an estimate before each batch.
ROWS_MAX_USD=6
# 1 builds the requests and prints the estimate without calling the API (no key needed).
ROWS_PLAN_ONLY=1
# 1 sends plain Messages API requests instead of a batch (twice the price, minutes instead of an hour).
ROWS_DIRECT=0
# Minutes the job waits for a batch (the job's own limit is 240).
ROWS_WAIT_MIN=200
