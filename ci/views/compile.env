# Settings for .github/workflows/views-compile.yml (read by ci/views/compile.sh). Push a commit to run/views-compile/<label> to run.
#
# The views to draft, comma separated; each is a job file tools/views/compile/<key>.json.
COMPILE_JOBS=jumper,bee,primate,whale,scorpion,cephalopod
# The models, comma separated (a model needs a price in tools/lit/extract.py). The first is the draft model.
COMPILE_MODELS=claude-haiku-5-5,claude-sonnet-5-5
# The most the run may spend, in US dollars at batch prices, judged by the ceiling estimate before each batch.
COMPILE_MAX_USD=5
# 1 sends plain Messages API requests instead of a batch (for a first trial; twice the price, minutes instead of an hour).
COMPILE_DIRECT=0
# 1 builds the requests and prints the estimate without calling the API (no key needed).
COMPILE_PLAN_ONLY=0
# 1 keeps the drafts already on the branch pub/views-draft and adds these.
COMPILE_KEEP=1
# Minutes the job waits for the batch (the job's own limit is 240).
COMPILE_WAIT_MIN=200
# Requests a view may take; the later ones carry the errors of the one before. COMPILER.md says 2.
COMPILE_ATTEMPTS=3
