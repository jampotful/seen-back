# Settings for .github/workflows/lit-table.yml (read by ci/lit/table.sh). Push a commit to run/lit-table/<label> to run.
#
# Topics to extract, comma separated, or "all". The topic names are the folders of the branch pub/lit-t1.
LIT_TABLE_TOPICS=spider-night
# The extractor for the topics above (claude-haiku-5-5 or claude-sonnet-5-5; a model needs a price in extract.py).
LIT_MODEL=claude-haiku-5-5
# Optional: the topics in LIT_STRONG_TOPICS (a subset of the list above) are read by LIT_STRONG_MODEL instead.
LIT_STRONG_MODEL=
LIT_STRONG_TOPICS=
# The most each extraction step may spend, in US dollars at batch prices, judged by the step's ceiling estimate. The
# script sends the topics, in order, that fit under it, and lists the rest as not sent in the summary.
LIT_MAX_USD=12
# 1 starts from the tables already on the branch pub/lit-table (for a full run sent in several pushes).
LIT_KEEP=0
# 1 skips the table and runs only the calibration.
LIT_SKIP_TABLE=1
# 1 also extracts the sources that the three finished research units cite and compares the result with the agents' logs;
# the comparison comes back as out/calib-<model>/CALIBRATION.md. LIT_CALIB_MODELS names the models, comma separated.
LIT_CALIBRATE=1
LIT_CALIB_MODELS=claude-haiku-5-5,claude-sonnet-5-5
# 1 builds the passages and prints the cost estimate without calling the API (no key needed); 0 runs.
LIT_PLAN_ONLY=0
# Minutes the job waits for the batches (the job's own limit is 360).
LIT_WAIT_MIN=330
