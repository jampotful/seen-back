# Settings for .github/workflows/lit-audit.yml (read by ci/lit/audit.sh). Push a commit to run/lit-audit/<label> to run.
#
# The units to audit, comma separated, or "all" (every branch research/<unit> that holds docs/views/evidence/<unit>.jsonl).
AUDIT_UNITS=all
# At most this many records of each unit (a trial); 0 sends every record.
AUDIT_LIMIT=0
# The most the first pass (Haiku 5.5, Batches API) may spend, in US dollars, judged by its ceiling estimate.
AUDIT_MAX_USD=2
# 1 also settles the flagged records from the source passages in the collection with the second-pass model.
AUDIT_ADJUDICATE=0
AUDIT_ADJ_MODEL=claude-sonnet-5-5
AUDIT_ADJ_MAX_USD=2
# 1 prints the plan and cost estimates without calling the API (no key needed); 0 runs.
AUDIT_PLAN_ONLY=0
# Minutes the job waits for each batch (the job's own limit is 240).
AUDIT_WAIT_MIN=150

# Burst 6. Which prompt the first pass uses: v1 (quote and source line) or v2 (adds the work card from the index).
AUDIT_PROMPT=v2
# first: the first pass (then the second when AUDIT_ADJUDICATE=1); second: only the second pass on the records an earlier run
# left undecided. The second mode reads flagged.jsonl from AUDIT_FLAGGED_REF and adjudicated.jsonl from AUDIT_RETRY_REF
# (paths on the ci branch, for example runs/lit-audit/4).
AUDIT_MODE=second
AUDIT_FLAGGED_REF=runs/lit-audit/4
AUDIT_RETRY_REF=
# The branch that receives the results.
AUDIT_PUB_BRANCH=pub/lit-audit-v2c
AUDIT_IDS_FILE=ci/lit/audit-ids-v2only.txt
