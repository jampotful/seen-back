+       "    S.selftest = true;   // at once, as the self-test did when it was part of this script: the page's loop leaves the drawing to it\n"
+       "    window.__seenBackSelftest = { " + ", ".join("'%s': %s" % (n, n) for n in SELFTEST_READS) + " };\n"
