+// The threads experiment (ci/engines/patches/coi-sw.patch): every answer this worker gives is handed over with the two headers that
+// make the page cross-origin isolated, which GitHub Pages cannot send. 'credentialless' is the other value tried.
+const COEP = 'require-corp';
+function isolate(res) {
+  if (!res || res.type === 'opaque' || res.type === 'opaqueredirect' || res.type === 'error' || res.status === 0) return res;
+  const h = new Headers(res.headers);
+  h.set('Cross-Origin-Embedder-Policy', COEP);
+  h.set('Cross-Origin-Opener-Policy', 'same-origin');
+  return new Response(res.body, { status: res.status, statusText: res.statusText, headers: h });
+}
